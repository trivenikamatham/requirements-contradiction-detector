# Requirements Contradiction Detector Environment Configuration
SECRET_KEY=django-insecure-requirements-contradiction-detector-key-local-demo
DEBUG=True
ALLOWED_HOSTS=*

# Provider Selection: 'mock' (safe offline heuristic), 'openai', or 'groq'
LLM_PROVIDER=mock

# Embedding Selection: 'local' (offline Scikit-Learn TF-IDF), 'openai', or 'mock'
EMBEDDING_PROVIDER=local

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Defaults
SIMILARITY_THRESHOLD=0.50
MAX_UPLOAD_SIZE_MB=15
