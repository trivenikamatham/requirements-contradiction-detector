# Requirements Contradiction Detector Environment Configuration
# Copy this file to .env and configure your keys if using external LLM / Embedding services.

# Django Settings
SECRET_KEY=django-insecure-requirements-contradiction-detector-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*

# Provider Selection
# LLM_PROVIDER options: 'openai', 'groq', 'mock'
# If set to 'mock' or if API keys are absent, a safe rule-based heuristic LLM is used.
LLM_PROVIDER=mock

# EMBEDDING_PROVIDER options: 'openai', 'local', 'mock'
# 'local' uses Scikit-Learn TF-IDF vector embeddings (fast, 100% offline, zero external dependencies).
EMBEDDING_PROVIDER=local

# OpenAI Configuration (optional, if LLM_PROVIDER or EMBEDDING_PROVIDER is 'openai')
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq Configuration (optional, fast alternative LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Analysis Parameters
SIMILARITY_THRESHOLD=0.50
MAX_UPLOAD_SIZE_MB=15
